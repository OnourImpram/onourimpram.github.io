adding-top:75px;padding-bottom:70px}.v4-room-grid{grid-template-columns:repeat(2,1fr);gap:20px}.v4-room{height:390px}.v4-room:nth-child(even){margin-top:0}.v4-heading h2{font-size:42px}.v4-craft-grid{gap:35px}.v4-craft-art{min-height:560px}.v4-detail-selector{gap:16px}.v4-product-grid{grid-template-columns:repeat(2,1fr);gap:40px 25px}.v4-selection{padding-top:75px;padding-bottom:75px}.v4-product-grid .product-visual{aspect-ratio:1.06}.v4-material-grid{gap:35px}.v4-sample-art{height:485px;padding:35px 18px}.v4-sample-label{min-width:190px;padding:20px}.v4-material-tabs{gap:13px}.v4-material-tabs button{flex-direction:column;gap:12px;padding-bottom:12px;min-width:58px}.v4-material-copy h2{font-size:41px}.v4-bespoke{gap:40px;grid-template-columns:1fr 1fr;padding-top:80px;padding-bottom:80px}.v4-draft-top,.v4-draft-bottom{font-size:8px;padding:16px;flex-direction:column;gap:5px}.v4-process{padding:65px 0}.v4-process-grid{grid-template-columns:1fr;gap:28px}.v4-process-nav{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.v4-process-nav button{grid-template-columns:1fr;padding:15px 0;gap:14px;align-content:start}.v4-process-nav strong{font-size:21px}.v4-process-nav svg{display:none}#v4-process-panel{min-height:300px}#v4-process-panel>div{padding:35px}#v4-process-panel>img{max-height:360px}.v4-journal{padding:70px 0}.v4-journal-grid{gap:22px}.v4-journal-grid h3{font-size:24px}.v4-journal-grid p{display:none}.v4-faq{gap:45px;padding-bottom:70px}.v4-value{padding:5px 12px}.v4-value h2{font-size:19px}.v4-value p{font-size:11px}.v4-hero-bottom{bottom:54px}}
@media(max-width:600px){.wrap{width:calc(100% - 40px)}.preview-bar{padding:0 14px;height:26px;min-height:26px;font-size:8px}.preview-bar>button{font-size:0;min-width:22px;gap:0}.preview-bar>button svg{width:13px}.site-header.home-header{top:26px}.header-inner{width:calc(100% - 28px);min-height:82px;gap:8px}.brand>span{font-size:16px;letter-spacing:.15em}.brand small{font-size:6px;letter-spacing:.12em}.brand img{height:48px;width:18px}.header-tools{gap:0}.header-tools .icon-button{min-width:35px;width:35px}.cart-nav span{font-size:10px}.v4-home h2{font-size:39px}.v4-hero{height:calc(100svh - 26px);min-height:760px}.v4-hero-body{padding-top:163px;padding-bottom:150px;text-align:left}.v4-hero-body .eyebrow{font-size:8px;letter-spacing:.18em}.v4-hero-photo img{object-position:59% 50%;filter:brightness(.86)}.v4-hero-veil{background:linear-gradient(90deg,#211b149c,#2a20175c 70%),linear-gradient(0deg,#211b1490,transparent 45%,#211b141f)}.v4-hero h1{font-size:clamp(48px,12.8vw,65px);line-height:1.03;letter-spacing:-.035em;margin:28px 0 24px;max-width:100%}.v4-hero-body>p{font-size:13px;line-height:1.85;max-width:300px;margin-bottom:23px}.v4-hero-actions{gap:17px;align-items:flex-start;flex-direction:column}.v4-hero-actions .button{min-height:49px;padding:14px 19px;font-size:11px;gap:27px}.v4-hero-actions .text-link{font-size:11px;gap:25px}.v4-hero-bottom{bottom:54px;gap:20px;flex-wrap:wrap}.v4-scene-controls{gap:8px}.v4-scene-controls button{min-width:35px;gap:8px}.v4-scene-controls button[aria-pressed=true] i{width:33px}.v4-scene-controls span{font-size:10px}.v4-scene-caption{margin-left:auto;max-width:168px;column-gap:9px}.v4-scene-caption strong{font-size:17px;line-height:1.3}.v4-scene-caption span{font-size:7px;line-height:1.6;letter-spacing:.1em}.v4-scene-caption svg{width:16px}.v4-down{display:none}.v4-image-note{font-size:8px;right:20px;bottom:15px}.v4-values>.wrap{grid-template-columns:1fr 1fr;padding:24px 0;gap:0}.v4-value{padding:14px 9px}.v4-value:nth-child(2){border:0}.v4-value:nth-child(-n+2){border-bottom:1px solid #dacfc0}.v4-value h2{font-size:19px}.v4-value p{font-size:10px}.v4-value>svg{width:23px;height:23px;margin-bottom:10px}.v4-intro{grid-template-columns:1fr;gap:22px;padding-top:53px;padding-bottom:53px}.v4-index{font-size:8px;line-height:1.7;letter-spacing:.16em}.v4-intro h2{font-size:36px;margin-bottom:20px}.v4-intro p{font-size:13px;line-height:1.85}.v4-heritage{display:flex;flex-direction:column}.v4-heritage-photo{height:310px}.v4-heritage-photo>span{left:20px;bottom:18px;font-size:8px}.v4-photo-seal{width:82px;height:82px;top:20px;right:20px;font-size:8px}.v4-photo-seal i{font-size:13px}.v4-heritage-copy{padding:43px 25px 49px}.v4-heritage-copy h2{font-size:42px;margin:24px 0}.v4-heritage-copy h2>br:first-of-type{display:none}.v4-heritage-copy p{font-size:13px;line-height:1.9}.v4-heading{align-items:flex-start;flex-direction:column;gap:20px;margin-bottom:27px}.v4-heading .eyebrow{margin-bottom:19px}.v4-heading h2{font-size:38px}.v4-heading p{font-size:12px!important;line-height:1.8;margin-bottom:16px!important}.v4-rooms{padding:58px 0 48px}.v4-room-grid{gap:12px}.v4-room{height:275px}.v4-room>div{left:13px;right:10px;bottom:19px}.v4-room span{font-size:8px;line-height:1.6;letter-spacing:.04em}.v4-room h3{font-size:23px;line-height:1.2;margin:9px 0 0}.v4-room svg{display:none}.v4-small-note{font-size:10px!important}.v4-craft{padding:51px 0}.v4-craft-grid{grid-template-columns:1fr;gap:28px}.v4-craft h2{font-size:43px}.v4-craft p{font-size:13px}.v4-craft-art{min-height:330px;height:330px;order:-1}.v4-craft-frame{inset:15px}.v4-craft-tag{left:27px;right:27px;bottom:60px}.v4-craft-tag span,.v4-craft-tag strong{font-size:8px}.v4-craft-caption{font-size:9px;padding:12px 16px}.v4-detail-copy{margin-top:23px;min-height:170px}.v4-detail-copy h3{font-size:26px}.v4-detail-selector{gap:28px}.v4-detail-selector button{font-size:12px}.v4-selection{padding:60px 0}.v4-product-grid{gap:31px 15px}.v4-product-grid .product-visual{aspect-ratio:.75}.v4-product-grid .product-caption{padding-top:14px}.v4-product-grid .product-caption h3{font-size:29px;margin:6px 0}.v4-product-grid .product-caption p{font-size:10px;line-height:1.6}.v4-product-grid .label{font-size:8px}.v4-product-grid .image-index{font-size:7px;padding:6px}.v4-product-grid .save-button{width:35px;height:35px;right:8px;top:8px}.v4-product-grid .card-arrow{display:none}.v4-materials{padding:45px 0}.v4-material-grid{grid-template-columns:1fr;gap:42px}.v4-sample-art{height:380px;padding:25px 34px}.v4-sample-board{width:74%;max-width:270px}.v4-sample-label{min-width:192px;bottom:22px;left:-18px;padding:16px 23px}.v4-sample-label>strong{font-size:31px}.v4-sample-label>span{font-size:8px}.v4-material-copy h2{font-size:42px}.v4-material-copy>p{font-size:13px}.v4-material-tabs{gap:27px}.v4-material-tabs button{flex-direction:row;gap:9px;min-width:auto;font-size:11px}.v4-material-tabs button>span{width:25px;height:25px}#v4-material-panel{min-height:164px}#v4-material-panel h3{font-size:29px}#v4-material-panel p{font-size:12px}.v4-bespoke{grid-template-columns:1fr;gap:32px;padding:59px 0 65px}.v4-bespoke-copy h2{font-size:43px}.v4-bespoke-copy>p{font-size:13px}.v4-draft{transform:none;box-shadow:5px 8px 0 #e9e0d2}.v4-draft-top,.v4-draft-bottom{flex-direction:row;font-size:8px;gap:12px;padding:16px}.v4-draft-bottom>span{font-size:8px;text-align:right}.v4-brief-range output{font-size:27px}.v4-process{padding:55px 0}.v4-process-grid{gap:23px}.v4-process-nav{grid-template-columns:1fr 1fr;gap:8px 20px}.v4-process-nav button{padding:16px 0;gap:10px}.v4-process-nav strong{font-size:23px}.v4-process-nav button>span{font-size:17px}#v4-process-panel{display:block;min-height:0}#v4-process-panel>img{height:230px}#v4-process-panel>div{padding:27px 24px 33px}#v4-process-panel h3{font-size:30px}#v4-process-panel p{font-size:13px}.v4-journal{padding:60px 0 40px}.v4-journal-grid{grid-template-columns:1fr;gap:12px}.v4-journal-grid>a{display:grid;grid-template-columns:105px 1fr;gap:18px;border-bottom:1px solid #d9cebb;padding:12px 0 22px}.v4-journal-grid .photo{aspect-ratio:.8!important;align-self:start;margin-top:3px}.v4-journal-grid>a>div{padding:0}.v4-journal-grid span{font-size:8px}.v4-journal-grid h3{font-size:24px;margin:9px 0 14px}.v4-journal-grid strong{font-size:10px}.v4-faq{grid-template-columns:1fr;gap:27px;padding-top:18px;padding-bottom:60px}.v4-faq h2{font-size:39px}.v4-faq .accordion summary{font-size:13px}.v4-faq .answer{font-size:12px}.v4-closing{padding:61px 0 38px}.v4-closing h2{font-size:45px;line-height:1.12}.v4-closing .eyebrow{font-size:8px;letter-spacing:.16em;line-height:1.8}.v4-closing .wrap>span{font-size:11px}.v4-closing-signature{font-size:8px;margin-top:42px}.footer-wordmark{font-size:17vw}.site-footer .footer-top{gap:30px}.site-footer .footer-disclosure{font-size:10px;line-height:1.8}}
@media(prefers-reduced-motion:reduce){.v4-home *, .v4-home *:before,.v4-home *:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal-ready{opacity:1;transform:none}html{scroll-behavior:auto}}
@media print{.preview-bar,.site-header,.site-footer,.v4-hero,.v4-values,.v4-closing{display:none}.reveal-ready{opacity:1;transform:none}.wrap{width:100%}}

.home-header .icon-button:hover,.home-header .icon-button:focus-visible{background:#fff5e21c;color:#fff8ec}.home-header .icon-button:focus-visible{outline:2px solid #ead6b8;outline-offset:3px}@media(max-width:600px){html{scrollbar-gutter:auto}}
