/* Original Elif editorial layer. Reference patterns, never third-party assets. */
:root{--paper:#f5f1e9;--paper-deep:#eae3d7;--ink:#352e25;--muted:#736653;--line:#d9d0c3;--wood:#77563d;--serif:'Iowan Old Style','Palatino Linotype','Book Antiqua',Georgia,serif;--v4-ease:cubic-bezier(.22,.68,0,1)}
html{scrollbar-gutter:stable}html:has(dialog[open]){overflow:hidden}.wrap{max-width:1440px;width:calc(100% - 112px)}.preview-bar{background:#29251f;color:#e4d9c9;font-size:10px;letter-spacing:.035em;min-height:30px;height:30px;padding:0 32px}.preview-bar>span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.preview-bar>button{flex-shrink:0;color:inherit;font-size:10px}.site-header.home-header{position:absolute;inset:30px 0 auto;z-index:20;background:transparent;color:#fff8ec;border-bottom:1px solid #fff2db35}.home-header .brand,.home-header .icon-button,.home-header .nav-left a,.home-header .nav-right a,.home-header .brand small{color:#fff8ec}.home-header .brand img{filter:brightness(1.65)}.header-inner{max-width:1510px;width:calc(100% - 80px);min-height:106px}.brand>span{letter-spacing:.17em}.brand small{letter-spacing:.18em}.nav-left,.nav-right nav{gap:23px}.nav-left a,.nav-right nav a{font-size:12px;position:relative;padding:15px 0}.nav-left a:after,.nav-right nav a:after{content:'';position:absolute;bottom:7px;left:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s}.nav-left a:hover:after,.nav-right nav a:hover:after{transform:scaleX(1)}.icon-button{min-width:44px;min-height:44px}.site-header:not(.home-header){background:var(--paper)}.v4-home h1,.v4-home h2,.v4-home h3{font-family:var(--serif);font-weight:400}.v4-home h2{font-size:clamp(36px,3.8vw,64px);line-height:1.1;letter-spacing:-.035em}.v4-home h2 em{color:#826448;font-weight:400}.v4-home p{font-size:15px;line-height:1.85;color:#756754}.v4-home .eyebrow{font-size:10px;letter-spacing:.23em;font-weight:400}.v4-home .button{background:#654a32;border:1px solid #654a32;color:#fff8ed;border-radius:0;min-height:53px;padding:17px 24px;gap:30px;font-size:12px;letter-spacing:.02em;transition:background .2s,transform .2s}.v4-home .button:hover{background:#4a3624;border-color:#4a3624;transform:translateY(-1px)}.v4-home .text-link{font-size:12px;gap:20px}.v4-home .text-link svg{transition:transform .25s}.v4-home .text-link:hover svg{transform:translateX(4px)}.v4-home .photo img{transition:transform .6s var(--v4-ease)}.v4-home a:hover .photo img{transform:scale(1.025)}.v4-small-note{font-size:11px!important;line-height:1.7!important;color:#81715d!important;margin-top:18px!important}
.v4-hero{position:relative;height:min(960px,calc(100svh - 30px));min-height:760px;max-height:none;overflow:hidden;color:#fff8ed;background:#453727}.v4-hero-photo,.v4-hero-veil{position:absolute;inset:0}.v4-hero-photo img{width:100%;height:100%;object-fit:cover;object-position:66% 52%;animation:v4-scene-in .65s var(--v4-ease) both}.v4-hero-veil{pointer-events:none;background:linear-gradient(90deg,#211b14d1 0%,#292017a6 28%,#39291a40 58%,#30241b0a 80%),linear-gradient(0deg,#241b1470,transparent 35%,transparent 73%,#1a17133d)}.v4-hero-body{position:relative;padding-top:clamp(175px,23vh,248px);padding-bottom:130px}.v4-hero-body .eyebrow{color:#efe3cf;font-size:10px}.v4-hero h1{font-size:clamp(58px,6.2vw,98px);line-height:.99;letter-spacing:-.043em;max-width:710px;margin:30px 0 26px;color:#fff9ef}.v4-hero h1>span,.v4-hero h1>em{display:block}.v4-hero h1>em{font-style:italic;font-weight:400}.v4-hero-body>p{max-width:540px;line-height:1.8;font-size:15px;color:#f4ecde;margin-bottom:27px}.v4-hero-actions{display:flex;align-items:center;gap:30px;flex-wrap:wrap}.v4-hero-actions .button{background:#f1e8d9;border-color:#f1e8d9;color:#463421}.v4-hero-actions .button:hover{background:#fffaf1;border-color:#fffaf1}.v4-hero-actions .text-link{color:#fff6e6}.v4-hero-bottom{position:absolute;left:0;right:0;bottom:64px;display:flex;align-items:center;gap:30px}.v4-scene-controls{display:flex;gap:12px;align-items:center}.v4-scene-controls button{padding:12px 0;display:flex;align-items:center;gap:12px;color:#f6ead7;min-width:44px;min-height:44px;cursor:pointer}.v4-scene-controls span{font-size:11px;letter-spacing:.05em}.v4-scene-controls i{width:0;height:1px;background:#e4ccb0;transition:width .3s}.v4-scene-controls button[aria-pressed=true] i{width:52px}.v4-scene-caption{margin-left:auto;display:grid;grid-template-columns:1fr 30px;align-items:center;gap:5px 20px;color:#f9f0e1}.v4-scene-caption span{font-size:9px;letter-spacing:.15em}.v4-scene-caption strong{font-family:var(--serif);font-weight:400;font-size:21px;grid-row:2}.v4-scene-caption svg{grid-column:2;grid-row:1/3}.v4-down{height:48px;width:48px;display:grid;place-items:center;border:1px solid #e7d2b88c;border-radius:50%;color:#fff3e0}.v4-image-note{position:absolute;bottom:15px;right:32px;font-size:10px;letter-spacing:.03em;color:#e8dac8}
.v4-values{background:#f1ece3;border-bottom:1px solid #e1d7c8}.v4-values>.wrap{display:grid;grid-template-columns:repeat(4,1fr);padding:35px 0}.v4-value{text-align:center;padding:5px 25px;border-right:1px solid #dacfc0}.v4-value:last-child{border:0}.v4-value>svg{color:#8d6c4b;margin-bottom:13px}.v4-value h2{font-size:22px;letter-spacing:-.01em;line-height:1.25}.v4-value p{font-size:12px;line-height:1.6;margin:9px 0 0}.v4-intro{display:grid;grid-template-columns:1fr 3.2fr .7fr;gap:35px;padding-top:91px;padding-bottom:96px;align-items:center}.v4-index{font-size:9px;line-height:2;letter-spacing:.18em;color:#897252}.v4-intro h2{font-size:clamp(35px,3.6vw,54px);margin:0 0 25px}.v4-intro p{max-width:660px;margin:0}.v4-intro-mark{height:126px;display:flex;justify-content:center}.v4-intro-mark img{height:100%;width:auto;object-fit:contain;opacity:.65}.v4-heritage{display:grid;grid-template-columns:1.12fr 1fr .46fr;min-height:595px;background:#eee7dc}.v4-heritage-photo{position:relative;overflow:hidden}.v4-heritage-photo>img{width:100%;height:100%;object-fit:cover;object-position:40% 50%;filter:saturate(.75)}.v4-heritage-photo>span{position:absolute;left:32px;bottom:26px;font-size:9px;letter-spacing:.18em;color:#f7e9d7}.v4-photo-seal{position:absolute;top:34px;right:32px;width:110px;height:110px;border:1px solid #ecd5b783;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:10px;line-height:1.6;letter-spacing:.18em;color:#f7ead8;background:#39281615}.v4-photo-seal i{font-family:var(--serif);font-size:17px;letter-spacing:0;margin-top:5px}.v4-heritage-copy{padding:66px 10% 55px;display:flex;flex-direction:column;justify-content:center}.v4-heritage-copy h2{font-size:clamp(38px,3.3vw,57px);margin:24px 0}.v4-heritage-copy p{font-size:14px;line-height:1.85;margin-bottom:18px}.v4-heritage-copy .text-link{align-self:flex-start;margin-top:10px}.v4-heritage-side{position:relative;overflow:hidden}.v4-heritage-side img{height:100%;width:100%;object-fit:cover;object-position:56% 50%}.v4-heritage-side span{position:absolute;bottom:33px;left:25px;font-size:9px;line-height:2;letter-spacing:.2em;color:#352c22;background:#f6ebd7b0;padding:12px}
.v4-heading{display:flex;justify-content:space-between;gap:55px;align-items:flex-end;margin-bottom:42px}.v4-heading .eyebrow{margin-bottom:22px}.v4-heading>div:last-child>p,.v4-heading>p{font-size:13px;line-height:1.8;margin-bottom:18px}.v4-heading>.text-link{white-space:nowrap}.v4-rooms{padding-top:110px;padding-bottom:80px}.v4-room-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.v4-room{position:relative;height:405px;color:#fcf5e9;overflow:hidden}.v4-room:nth-child(even){margin-top:30px}.v4-room>img{height:100%;width:100%;object-fit:cover;transition:transform .65s var(--v4-ease)}.v4-room:after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(transparent 42%,#1d1811c2)}.v4-room:hover img{transform:scale(1.04)}.v4-room>div{position:absolute;z-index:1;bottom:27px;left:24px;right:20px}.v4-room span{font-size:10px;letter-spacing:.1em}.v4-room h3{font-size:25px;line-height:1.3;margin:12px 22px 0 0;letter-spacing:-.015em}.v4-room svg{position:absolute;right:0;bottom:0}.v4-craft{background:#34392e;color:#f3eee2;padding:82px 0}.v4-craft-grid{display:grid;grid-template-columns:1fr 1.22fr;gap:95px;align-items:center}.v4-craft .eyebrow{color:#c1b191}.v4-craft h2{font-size:clamp(42px,4vw,66px);margin:24px 0}.v4-craft h2 em{color:#d0baa0}.v4-craft p{color:#d3cdbf;font-size:14px}.v4-detail-copy{margin-top:30px;padding-top:26px;border-top:1px solid #d8c6a843;min-height:184px}.v4-detail-copy>span{font-size:9px;letter-spacing:.16em;color:#c2af90}.v4-detail-copy h3{font-size:27px;line-height:1.3;margin:13px 0}.v4-detail-copy p{font-size:13px;line-height:1.8;margin:0}.v4-detail-selector{display:flex;gap:25px;margin-top:18px}.v4-detail-selector button{padding:14px 0;color:#d0c5b2;font-size:12px;display:flex;gap:10px;border-bottom:1px solid transparent;min-height:44px}.v4-d