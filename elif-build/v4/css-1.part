etail-selector button[aria-pressed=true]{color:#fff5e4;border-color:#c8b18f}.v4-detail-selector span{font-size:9px;opacity:.7}.v4-craft-art{position:relative;min-height:510px;height:100%;max-height:670px;overflow:hidden}.v4-craft-art>img{width:100%;height:100%;position:absolute;object-fit:cover}.v4-craft-frame{position:absolute;inset:25px;border:1px solid #f8e5c463;pointer-events:none}.v4-craft-tag{position:absolute;bottom:59px;left:45px;right:45px;color:#f8edda;display:flex;justify-content:space-between;align-items:center;padding-top:15px;border-top:1px solid #eee0c66b;text-shadow:0 1px 4px #22170c}.v4-craft-tag span,.v4-craft-tag strong{font-size:10px;letter-spacing:.15em;font-weight:400}.v4-craft-caption{position:absolute;bottom:0;left:0;right:0;background:#272c24ed;color:#ddd1bf;font-size:10px;padding:12px 20px}.v4-selection{padding-top:110px;padding-bottom:110px}.v4-product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.v4-product-grid .product-visual{aspect-ratio:.82}.v4-product-grid .product-visual img{object-fit:cover}.v4-product-grid .product-caption{padding-top:20px}.v4-product-grid .product-caption h3{font-size:31px}.v4-product-grid .product-caption p{font-size:11px}.v4-product-grid .label{font-size:9px;letter-spacing:.16em}.v4-product-grid .image-index{font-size:8px}.v4-product-grid .save-button{background:#f5ecddcf;width:40px;height:40px;border-radius:0}.v4-materials{padding:78px 0;background:#ece5d8}.v4-material-grid{display:grid;grid-template-columns:1.08fr 1fr;gap:100px;align-items:center}.v4-sample-art{height:570px;position:relative;padding:33px 38px;background:radial-gradient(ellipse at 40% 20%,#f9f4e9,#d8cbbb)}.v4-sample-board{height:100%;width:76%;margin:auto;position:relative;transform:rotate(-6deg);box-shadow:12px 22px 25px #49341d40;border-right:6px solid #74543a;border-bottom:6px solid #60452e}.v4-sample-board>img{width:100%;height:100%;object-fit:cover}.v4-sample-label{position:absolute;bottom:30px;left:-15px;background:#f7f1e4;color:#443525;padding:20px 30px;box-shadow:0 2px 6px #0002;transform:rotate(6deg);min-width:225px;display:grid;gap:8px}.v4-sample-label>span{font-size:9px;letter-spacing:.14em}.v4-sample-label>strong{font-family:var(--serif);font-size:38px;font-weight:400}.v4-sample-measure{position:absolute;right:12px;top:42px;writing-mode:vertical-rl;font-size:9px;letter-spacing:.2em;color:#756046}.v4-material-copy h2{margin:25px 0}.v4-material-copy>p{max-width:430px}.v4-material-tabs{display:flex;gap:24px;margin:24px 0 23px;border-bottom:1px solid #c8b89d}.v4-material-tabs button{padding:12px 0 15px;display:flex;align-items:center;gap:8px;font-size:12px;border-bottom:2px solid transparent;color:#695740}.v4-material-tabs button[aria-selected=true]{border-bottom-color:#674b32;color:#372819}.v4-material-tabs button>span{width:30px;height:30px;border-radius:50%;background-size:cover;outline:1px solid #a8977b;outline-offset:3px;margin-right:3px}#v4-material-panel{min-height:172px}#v4-material-panel h3{font-size:30px;margin-bottom:12px}#v4-material-panel p{font-size:13px;line-height:1.8}.v4-material-copy .v4-small-note{max-width:420px}
.v4-bespoke{padding-top:114px;padding-bottom:112px;display:grid;grid-template-columns:1fr 1.23fr;gap:90px;align-items:center}.v4-bespoke-copy h2{margin:24px 0}.v4-bespoke-copy>p{max-width:440px;font-size:14px}.v4-brief-range{display:block;margin:28px 0 14px}.v4-brief-range>span{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#77664f}.v4-brief-range output{font-family:var(--serif);font-size:27px;color:#4c3824}.v4-brief-range output small{font-family:var(--sans);font-size:12px}.v4-brief-range input{width:100%;height:30px;accent-color:#7e5a3c;margin:8px 0 0;cursor:pointer}.v4-range-hints small{font-size:10px}.v4-brief-materials{display:flex;gap:20px;margin:22px 0}.v4-brief-materials button{font-size:11px;padding:10px 0;display:flex;align-items:center;gap:9px;border-bottom:1px solid transparent;min-height:44px}.v4-brief-materials button[aria-pressed=true]{border-bottom-color:#6b4d30}.v4-brief-materials button>span{width:23px;height:23px;border-radius:50%;background-size:cover;outline:1px solid #b8a285;outline-offset:2px}.v4-draft{background-color:#eee7d8;background-image:linear-gradient(#b9a48614 1px,transparent 1px),linear-gradient(90deg,#b9a48614 1px,transparent 1px);background-size:20px 20px;border:1px solid #d9cab4;transform:rotate(1deg);box-shadow:8px 13px 0 #e9e0d2;position:relative}.v4-draft-top,.v4-draft-bottom{display:flex;justify-content:space-between;gap:15px;padding:22px 25px;font-size:9px;letter-spacing:.1em;line-height:1.6;color:#8a7356}.v4-draft-top{border-bottom:1px solid #d7c7ad}.v4-draft svg{width:100%;height:auto;display:block}.v4-draft-bottom{border-top:1px solid #d7c7ad}.v4-draft-bottom strong{font-weight:400;color:#51422f;font-size:11px;letter-spacing:0}.v4-process{background:#eae3d6;padding:95px 0}.v4-process-grid{display:grid;grid-template-columns:1fr 1.5fr;gap:70px}.v4-process-nav{display:flex;flex-direction:column;justify-content:center}.v4-process-nav button{display:grid;grid-template-columns:35px 1fr 24px;gap:15px;align-items:center;text-align:left;padding:28px 0;border-bottom:1px solid #ccbea9;color:#938167}.v4-process-nav button>span{font-family:var(--serif);font-size:22px;font-weight:400}.v4-process-nav strong{font-family:var(--serif);font-size:25px;line-height:1.2;font-weight:400}.v4-process-nav button[aria-selected=true]{color:#48321f;border-color:#866443}.v4-process-nav button svg{opacity:0}.v4-process-nav button[aria-selected=true] svg{opacity:1}#v4-process-panel{background:#f7f2e8;display:grid;grid-template-columns:1.05fr 1fr;min-height:410px}#v4-process-panel>img{width:100%;height:100%;object-fit:cover}#v4-process-panel>div{padding:42px 32px;align-self:center}#v4-process-panel span{font-size:9px;letter-spacing:.16em;color:#92785a}#v4-process-panel h3{font-size:31px;line-height:1.2;margin:19px 0}#v4-process-panel p{font-size:13px;line-height:1.8;margin:0}.v4-journal{padding-top:106px;padding-bottom:98px}.v4-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}.v4-journal-grid>a>div{padding:22px 0}.v4-journal-grid span{font-size:9px;letter-spacing:.18em;color:#8b7155}.v4-journal-grid h3{font-size:30px;line-height:1.22;margin:15px 0 13px;letter-spacing:-.025em}.v4-journal-grid p{font-size:13px;line-height:1.8}.v4-journal-grid strong{font-size:11px;font-weight:400;display:flex;align-items:center;gap:25px}.v4-faq{display:grid;grid-template-columns:.8fr 1.3fr;gap:100px;padding-bottom:100px}.v4-faq h2{margin:23px 0 30px}.v4-faq .accordion summary{font-size:15px}.v4-faq .answer{font-size:14px;color:#78684f}.v4-closing{position:relative;overflow:hidden;background:#473524;color:#fbf2e4;text-align:center;padding:97px 0 63px}.v4-closing-grain{position:absolute;inset:0;opacity:.2;background-size:cover;filter:saturate(.3);pointer-events:none}.v4-closing>.wrap{position:relative}.v4-closing h2{font-size:clamp(42px,5.6vw,86px);line-height:1.09;margin:28px 0 35px}.v4-closing h2 em{color:#ddc2a3}.v4-closing .eyebrow{color:#d0bda4}.v4-closing .button{background:#f0e5d4;border-color:#f0e5d4;color:#4d3720}.v4-closing .button:hover{background:#fff9ee}.v4-closing .wrap>span{display:block;font-size:12px;color:#d6c6b0;margin-top:24px}.v4-closing-signature{position:relative;font-size:9px;letter-spacing:.24em;color:#bca58a;margin-top:62px}.site-footer{background:#272c24}.footer-wordmark{color:#ddd3c0;opacity:.15}.reveal-ready{opacity:0;transform:translateY(16px);transition:opacity .65s var(--v4-ease),transform .65s var(--v4-ease)}.reveal-ready.is-visible{opacity:1;transform:none}@keyframes v4-scene-in{from{opacity:.65;transform:scale(1.015)}to{opacity:1;transform:scale(1)}}
@media(min-width:1700px){.v4-hero-body{padding-top:235px}.v4-hero h1{font-size:102px}.v4-room{height:475px}}
@media(max-width:1200px){.nav-right nav{display:none}.v4-hero{min-height:740px}.v4-hero h1{font-size:78px}.v4-room h3{font-size:23px}.v4-craft-grid,.v4-material-grid,.v4-bespoke{gap:55px}.v4-heritage{grid-template-columns:1.1fr 1fr .34fr}.v4-heritage-copy{padding:45px 8%}.v4-heritage-copy h2{font-size:41px}.v4-heritage-side span{left:10px;padding:10px}.v4-room{height:330px}.v4-material-tabs{gap:18px}.v4-product-grid{gap:18px}.v4-process-grid{gap:35px}#v4-process-panel>div{padding:28px 24px}.v4-process-nav strong{font-size:22px}.v4-sample-art{height:500px}.v4-heading{gap:35px}}
@media(max-width:900px){.wrap{width:calc(100% - 64px)}.header-inner{width:calc(100% - 48px);min-height:88px}.nav-left{display:none}.mobile-menu{display:grid}.v4-hero{height:830px;min-height:0}.v4-hero-body{padding-top:180px}.v4-hero h1{font-size:76px}.v4-hero-photo img{object-position:59% 50%}.v4-intro{grid-template-columns:1fr 4fr;gap:30px;padding:65px 0}.v4-intro-mark{display:none}.v4-intro h2{font-size:40px}.v4-heritage{grid-template-columns:1fr 1fr;min-height:545px}.v4-heritage-side{display:none}.v4-heritage-copy h2{font-size:43px}.v4-rooms{p